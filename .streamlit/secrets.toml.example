# Copy this to .streamlit/secrets.toml and fill in your real values.
# On Streamlit Cloud, paste these key=value pairs in:
#   Settings → Secrets

SH_CLIENT_ID            = "your-sentinel-hub-client-id"
SH_CLIENT_SECRET        = "your-sentinel-hub-client-secret"
GEE_PROJECT             = "your-gee-project-id"
OPENTOPOGRAPHY_API_KEY  = "your-opentopography-api-key"
